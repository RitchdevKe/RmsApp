# ─────────────────────────────────────────────────────────────────────────────
# TASK-ME-DUO-APP — Environment variables
# Copy to `.env` for local dev. On Vercel, set these under
# Project → Settings → Environment Variables (Production + Preview).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (client, exposed to the browser — safe to publish) ─────────────
# Required by the Vite frontend. Find these in your Supabase project →
# Project Settings → API. Use the project URL and the "anon" / "publishable" key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Optional fallback name some code paths also read:
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# ── Supabase (server-side only — Edge Functions & migrations) ───────────────
# DO NOT add these to Vercel as VITE_* — they must never reach the browser.
# Used only when deploying Edge Functions / running migrations.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_SERVER_ONLY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET_IF_CONFIGURED

# ── Gemini / Google GenAI (optional) ────────────────────────────────────────
GEMINI_API_KEY=

# ── Email — Resend (used by send-email Edge Function) ───────────────────────
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=nonreply@mail.task-me.ke

# ── SMS — set SMS_PROVIDER to enable real delivery ──────────────────────────
# Supported: "africastalking" | "twilio"  (leave blank to queue/log only)
SMS_PROVIDER=

# Africa's Talking (recommended for Kenya)
AT_API_KEY=YOUR_AT_API_KEY
AT_USERNAME=sandbox
AT_SENDER_ID=TASKME

# Twilio (alternative)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+1234567890

# ── WhatsApp — Meta Cloud API ───────────────────────────────────────────────
WHATSAPP_API_KEY=YOUR_META_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID

# ── Website (public-facing site) ────────────────────────────────────────────
VITE_WEBSITE_URL=https://task-me.ke

# ── Website API (optional) ──────────────────────────────────────────────────
VITE_WEBSITE_API_URL=
VITE_WEBSITE_API_KEY=
